# Strava OAuth Configuration Template
# Copy this to .env.local and fill in your actual values

# Backend environment variables (used by serverless functions)
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:5173/#/auth/strava

# Frontend environment variables (prefixed with VITE_ to be accessible in browser)
VITE_STRAVA_CLIENT_ID=your_client_id_here

# Production values for Vercel
# STRAVA_REDIRECT_URI=https://your-app-name.vercel.app/#/auth/strava
# VITE_STRAVA_CLIENT_ID=your_client_id_here
